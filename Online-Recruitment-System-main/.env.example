# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ors


# Long, random, unguessable string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Only needed if the frontend is ever hosted on a different origin than
# this backend (not needed for the default setup, where Express serves
# the frontend itself).
# CLIENT_ORIGIN=http://localhost:5000

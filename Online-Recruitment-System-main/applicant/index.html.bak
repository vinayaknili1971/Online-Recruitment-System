<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Recruitment System - Applicant Module</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="applicant.css">
</head>

<body>

    <!-- ================= AUTH VIEW ================= -->
    <div id="auth-container" class="auth-container">

        <!-- Login Box -->
        <div id="login-box" class="auth-card">
            <div class="auth-header">
                <h2>Welcome Back</h2>
                <p>Log in to access your recruitment dashboard</p>
            </div>
            <form id="login-form" novalidate>
                <div class="form-group">
                    <label for="login-email">Email Address</label>
                    <input type="email" id="login-email" required placeholder="name@company.com">
                    <div class="error-msg" id="login-email-err"></div>
                </div>
                <div class="form-group">
                    <label for="login-password">Password</label>
                    <input type="password" id="login-password" required placeholder="••••••••">
                    <div class="error-msg" id="login-password-err"></div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Log In</button>
            </form>
            <div class="auth-footer">
                <p>Don't have an account? <a href="#" id="to-register">Create Account</a></p>
            </div>
        </div>

        <!-- Register Box -->
        <div id="register-box" class="auth-card hidden">
            <div class="auth-header">
                <h2>Create Account</h2>
                <p>Join us to search and apply for premium roles</p>
            </div>
            <form id="register-form" novalidate>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="reg-name">Full Name</label>
                        <input type="text" id="reg-name" required placeholder="John Doe">
                        <div class="error-msg" id="reg-name-err"></div>
                    </div>
                    <div class="form-group">
                        <label for="reg-email">Email Address</label>
                        <input type="email" id="reg-email" required placeholder="john.doe@example.com">
                        <div class="error-msg" id="reg-email-err"></div>
                    </div>
                    <div class="form-group">
                        <label for="reg-phone">Phone Number</label>
                        <input type="tel" id="reg-phone" required placeholder="555-0199">
                        <div class="error-msg" id="reg-phone-err"></div>
                    </div>
                    <div class="form-group">
                        <label for="reg-education">Highest Education</label>
                        <input type="text" id="reg-education" required placeholder="B.S. in Computer Science">
                        <div class="error-msg" id="reg-education-err"></div>
                    </div>
                    <div class="form-group span-2">
                        <label for="reg-skills">Skills (Comma-separated)</label>
                        <input type="text" id="reg-skills" required placeholder="JavaScript, HTML, CSS, React, SQL">
                        <div class="error-msg" id="reg-skills-err"></div>
                    </div>
                    <div class="form-group">
                        <label for="reg-password">Password (min 6 chars)</label>
                        <input type="password" id="reg-password" required placeholder="••••••••">
                        <div class="error-msg" id="reg-password-err"></div>
                    </div>
                    <div class="form-group">
                        <label for="reg-confirm">Confirm Password</label>
                        <input type="password" id="reg-confirm" required placeholder="••••••••">
                        <div class="error-msg" id="reg-confirm-err"></div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Sign Up</button>
            </form>
            <div class="auth-footer">
                <p>Already have an account? <a href="#" id="to-login">Log In</a></p>
            </div>
        </div>

    </div>

    <!-- ================= APP LAYOUT (LOGGED IN) ================= -->
    <div id="app-layout" class="app-layout hidden">

        <!-- Navigation Header -->
        <header class="app-header">
            <div class="header-container">
                <div class="logo">
                    <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span class="logo-text">Online Recruitment System</span>
                </div>
                <nav class="main-nav">
                    <button class="nav-link active" data-view="dashboard-view" id="nav-dashboard">Dashboard</button>
                    <button class="nav-link" data-view="jobs-view" id="nav-jobs">Find Jobs</button>
                    <button class="nav-link" data-view="applications-view" id="nav-applications">My
                        Applications</button>
                    <button class="nav-link" data-view="profile-view" id="nav-profile">Profile</button>
                    <button class="nav-link btn-logout" id="btn-logout">Logout</button>
                </nav>
            </div>
        </header>

        <!-- Main Content Container -->
        <main class="app-content">
            <div class="content-container">

                <!-- Notification Banner -->
                <div id="toast-notification" class="toast hidden"></div>

                <!-- ================= DASHBOARD VIEW ================= -->
                <section id="dashboard-view" class="content-section active-view">
                    <div class="welcome-header">
                        <h1>Welcome, <span id="applicant-display-name">Applicant</span>!</h1>
                        <p>Here is a summary of your job search progress</p>
                    </div>

                    <!-- Stats Grid -->
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon bg-indigo-100 text-indigo-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </div>
                            <div class="stat-content">
                                <h3>Total Applications</h3>
                                <p class="stat-number" id="stat-total">0</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-yellow-100 text-yellow-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="stat-content">
                                <h3>Pending</h3>
                                <p class="stat-number" id="stat-pending">0</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-blue-100 text-blue-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="stat-content">
                                <h3>Shortlisted</h3>
                                <p class="stat-number" id="stat-shortlisted">0</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-green-100 text-green-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div class="stat-content">
                                <h3>Selected</h3>
                                <p class="stat-number" id="stat-selected">0</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-red-100 text-red-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="stat-content">
                                <h3>Rejected</h3>
                                <p class="stat-number" id="stat-rejected">0</p>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity Row -->
                    <div class="dashboard-grid">
                        <!-- Recent Jobs -->
                        <div class="dashboard-block">
                            <div class="block-header">
                                <h2>Recent Jobs</h2>
                                <button class="link-btn" onclick="document.getElementById('nav-jobs').click();">Browse
                                    All Jobs</button>
                            </div>
                            <div class="jobs-list-simple" id="recent-jobs-list">
                                <!-- Injected via JavaScript -->
                            </div>
                        </div>

                        <!-- Recent Applications -->
                        <div class="dashboard-block">
                            <div class="block-header">
                                <h2>Recent Applications</h2>
                                <button class="link-btn"
                                    onclick="document.getElementById('nav-applications').click();">View All</button>
                            </div>
                            <div class="apps-list-simple" id="recent-apps-list">
                                <!-- Injected via JavaScript -->
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= JOBS VIEW ================= -->
                <section id="jobs-view" class="content-section hidden">
                    <div class="jobs-header">
                        <div>
                            <h1>Find Your Next Role</h1>
                            <p>Search and filter through the latest opportunities</p>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="search-container">
                        <div class="search-input-wrapper">
                            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="job-search-input"
                                placeholder="Search by Job Title, Company, Location, or Skills...">
                        </div>
                    </div>

                    <div class="jobs-layout-grid">
                        <!-- Filters Sidebar -->
                        <aside class="filters-sidebar">
                            <div class="sidebar-header">
                                <h3>Filters</h3>
                                <button class="btn btn-text text-sm" id="btn-clear-filters">Clear Filters</button>
                            </div>

                            <!-- Location Filter -->
                            <div class="filter-group">
                                <label for="filter-location">Location</label>
                                <select id="filter-location">
                                    <option value="">All Locations</option>
                                    <!-- Injected via JS dynamically based on jobs -->
                                </select>
                            </div>

                            <!-- Employment Type -->
                            <div class="filter-group">
                                <label>Employment Type</label>
                                <div class="checkbox-group">
                                    <label><input type="checkbox" name="filter-type" value="Full-time">
                                        Full-time</label>
                                    <label><input type="checkbox" name="filter-type" value="Part-time">
                                        Part-time</label>
                                    <label><input type="checkbox" name="filter-type" value="Contract"> Contract</label>
                                    <label><input type="checkbox" name="filter-type" value="Remote"> Remote</label>
                                </div>
                            </div>

                            <!-- Experience level -->
                            <div class="filter-group">
                                <label>Experience Level</label>
                                <div class="checkbox-group">
                                    <label><input type="checkbox" name="filter-exp" value="Entry Level"> Entry
                                        Level</label>
                                    <label><input type="checkbox" name="filter-exp" value="Mid Level"> Mid Level</label>
                                    <label><input type="checkbox" name="filter-exp" value="Senior Level"> Senior
                                        Level</label>
                                </div>
                            </div>
                        </aside>

                        <!-- Jobs Display Grid -->
                        <div class="jobs-display">
                            <div class="results-bar">
                                <span id="job-count-text">Showing 0 jobs</span>
                            </div>
                            <div class="jobs-grid" id="jobs-grid-container">
                                <!-- Injected via JS -->
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= JOB DETAILS VIEW ================= -->
                <section id="job-details-view" class="content-section hidden">
                    <button class="btn btn-text back-btn" id="btn-back-to-jobs">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon-sm" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to Jobs
                    </button>

                    <div class="job-detail-card" id="job-detail-card-content">
                        <!-- Injected via JS -->
                    </div>
                </section>

                <!-- ================= APPLY FORM VIEW ================= -->
                <section id="apply-view" class="content-section hidden">
                    <button class="btn btn-text back-btn" id="btn-back-to-details">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon-sm" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to Job Details
                    </button>

                    <div class="form-container">
                        <div class="form-header">
                            <h1>Submit Application</h1>
                            <p>Applying for: <strong class="text-indigo-600" id="apply-job-title">Job Title</strong> at
                                <span id="apply-job-company">Company Name</span></p>
                        </div>

                        <form id="application-submit-form" class="standard-form">
                            <input type="hidden" id="apply-job-id">

                            <div class="form-group">
                                <label for="apply-name">Full Name</label>
                                <input type="text" id="apply-name" readonly class="readonly-input">
                            </div>

                            <div class="form-group">
                                <label for="apply-email">Email Address</label>
                                <input type="email" id="apply-email" readonly class="readonly-input">
                            </div>

                            <div class="form-group">
                                <label for="apply-phone">Phone Number</label>
                                <input type="tel" id="apply-phone" required placeholder="Enter active contact number">
                            </div>

                            <div class="form-group">
                                <label for="apply-cover">Cover Letter</label>
                                <textarea id="apply-cover" rows="6" required
                                    placeholder="Explain why you are the perfect fit for this job..."></textarea>
                            </div>

                            <div class="form-group">
                                <label for="apply-resume">Resume File</label>
                                <div class="file-upload-wrapper">
                                    <input type="file" id="apply-resume" accept=".pdf,.doc,.docx" required>
                                    <div class="file-upload-label" id="file-upload-label">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="file-upload-icon" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                        </svg>
                                        <span>Click to upload resume (.pdf, .doc, .docx)</span>
                                    </div>
                                </div>
                                <div class="selected-file-display" id="selected-file-display"></div>
                            </div>

                            <button type="submit" class="btn btn-primary" id="btn-submit-application">Submit
                                Application</button>
                        </form>
                    </div>
                </section>

                <!-- ================= MY APPLICATIONS VIEW ================= -->
                <section id="applications-view" class="content-section hidden">
                    <div class="section-title-wrapper">
                        <h1>My Applications</h1>
                        <p>Track the progress and history of your job applications</p>
                    </div>

                    <div class="applications-layout">
                        <!-- Applications Table/Grid -->
                        <div class="applications-card">
                            <div class="table-responsive">
                                <table class="applications-table">
                                    <thead>
                                        <tr>
                                            <th>Application ID</th>
                                            <th>Job Title</th>
                                            <th>Company</th>
                                            <th>Applied Date</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="applications-table-body">
                                        <!-- Injected via JS -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="no-applications hidden" id="no-apps-message">
                                <p>You haven't applied for any jobs yet.</p>
                                <button class="btn btn-primary"
                                    onclick="document.getElementById('nav-jobs').click();">Find a Job</button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= APPLICATION DETAILS VIEW ================= -->
                <section id="app-details-view" class="content-section hidden">
                    <button class="btn btn-text back-btn" id="btn-back-to-apps">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon-sm" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to My Applications
                    </button>

                    <div class="app-details-card" id="app-details-card-content">
                        <!-- Injected via JS -->
                    </div>
                </section>

                <!-- ================= PROFILE VIEW ================= -->
                <section id="profile-view" class="content-section hidden">
                    <div class="section-title-wrapper">
                        <h1>My Profile</h1>
                        <p>Keep your professional profile updated for quick job applications</p>
                    </div>

                    <div class="profile-layout-grid">
                        <!-- Profile Info Summary -->
                        <div class="profile-summary-card">
                            <div class="avatar-container">
                                <div class="avatar-placeholder" id="avatar-initials">JD</div>
                            </div>
                            <h2 id="profile-card-name">Jane Doe</h2>
                            <p class="profile-card-email" id="profile-card-email">jane.doe@example.com</p>

                            <hr class="divider">

                            <div class="profile-info-block">
                                <span class="info-label">Active Resume</span>
                                <span class="info-value" id="profile-card-resume">None uploaded</span>
                            </div>
                        </div>

                        <!-- Profile Edit Form -->
                        <div class="profile-form-card">
                            <form id="profile-edit-form" class="standard-form">
                                <div class="form-grid-2">
                                    <div class="form-group">
                                        <label for="profile-name">Full Name</label>
                                        <input type="text" id="profile-name" required placeholder="John Doe">
                                    </div>
                                    <div class="form-group">
                                        <label for="profile-email">Email Address</label>
                                        <input type="email" id="profile-email" readonly class="readonly-input"
                                            title="Email cannot be changed as it is used for login.">
                                    </div>
                                    <div class="form-group">
                                        <label for="profile-phone">Phone Number</label>
                                        <input type="tel" id="profile-phone" required placeholder="555-0100">
                                    </div>
                                    <div class="form-group">
                                        <label for="profile-education">Highest Education</label>
                                        <input type="text" id="profile-education" required
                                            placeholder="M.S. in Computer Science">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="profile-skills">Skills (comma separated)</label>
                                    <input type="text" id="profile-skills" required placeholder="JavaScript, SQL, HTML">
                                </div>

                                <div class="form-group">
                                    <label for="profile-resume">Update Resume File</label>
                                    <div class="file-upload-wrapper">
                                        <input type="file" id="profile-resume" accept=".pdf,.doc,.docx">
                                        <div class="file-upload-label" id="profile-profile-upload-label">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="file-upload-icon" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                            </svg>
                                            <span>Click to select new resume file</span>
                                        </div>
                                    </div>
                                    <div class="selected-file-display" id="profile-selected-file-display"></div>
                                </div>

                                <button type="submit" class="btn btn-primary" id="btn-save-profile">Save
                                    Changes</button>
                            </form>
                        </div>
                    </div>
                </section>

            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer-bar">
            <div class="footer-container">
                <p>&copy; 2026 Online Recruitment System. All rights reserved.</p>
            </div>
        </footer>

    </div>

    <script src="applicant.js"></script>
</body>

</html>